# Reown AppKit project id for wallet connection (Ethereum). Create one at https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=

# Recommended: your own Ethereum mainnet RPC endpoint (Alchemy, Infura, QuickNode...).
# Without it the app uses https://ethereum-rpc.publicnode.com, a free public endpoint.
VITE_ETHEREUM_RPC_URL=
