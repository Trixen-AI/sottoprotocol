# Reown AppKit project id for wallet connection. Create one at https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=

# Optional: your own Solana mainnet RPC endpoint (recommended for production).
# Solana's public mainnet endpoint refuses browser requests, so the app defaults to
# https://solana-rpc.publicnode.com.
VITE_SOLANA_RPC_URL=
